    "name": "Fuel Route Optimizer API",
    "description": "API collection for Spotter Backend Assessment: Driving Route Fuel Optimization within the US.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Short Journey (<500 mi, No Stops) - LA to Las Vegas",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Los Angeles, CA\",\n  \"finish\": \"Las Vegas, NV\",\n  \"starting_fuel_gallons\": 50.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/route-plan/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "route-plan", ""]
        }
      }
    },
    {
